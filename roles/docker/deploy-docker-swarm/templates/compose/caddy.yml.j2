# services:
  caddy:
    image: caddy:2.10.2-alpine
    ports:
      - target: 80
        published: 80
        mode: host
      - target: 443
        published: 443
        mode: host
    volumes:
      # Mount the directory, not the file: ansible's template module replaces
      # files by rename, and a single-file bind mount pins the old inode, so
      # the container would never see config changes.
      - {{ remote_config }}/caddy:/etc/caddy:ro
      - {{ remote_data }}/caddy_data:/data
      - {{ remote_data }}/caddy_config:/config
      - {{ remote_data }}/letsencrypt:/etc/letsencrypt:ro
    networks:
      - local_net
    deploy:
      placement:
        constraints:
          - node.role == manager

