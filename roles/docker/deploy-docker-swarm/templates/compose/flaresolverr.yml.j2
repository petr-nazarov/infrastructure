# services:
  flaresolverr:
    # Headless Chromium that clears Cloudflare challenges for Prowlarr (an indexer
    # proxy there, for indexers tagged flaresolverr). Keeps no state, so no volume.
    image: ghcr.io/flaresolverr/flaresolverr:latest
    networks:
      - local_net
    environment:
      - TZ={{ tz }}
      - LOG_LEVEL=info
    deploy:
      replicas: 1
      placement:
        constraints:
          - "node.hostname == {{ hostname_media }}"
